@page "/lista-personas"
@using TRABAJO_PRACTICO_2_DE_PROGRAMACIÓN_MOVIL.Models

<h3 class="mb-4">Lista de Personas</h3>

<p class="text-muted">
    En esta página se muestran 10 personas cargadas en memoria al iniciar el componente.
</p>

<table class="table table-striped table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Imagen</th>
            <th>ID</th>
            <th>Nombre completo</th>
            <th>Email</th>
            <th>Domicilio</th>
            <th>Fecha de nacimiento</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var persona in personas)
        {
            <tr>
                <td>
                    <img src="@persona.RutaImagen"
                         alt="Imagen de persona"
                         width="60"
                         height="60"
                         class="rounded-circle" />
                </td>

                <td>@persona.Id</td>
                <td>@persona.NombreCompleto</td>
                <td>@persona.Email</td>
                <td>@persona.Domicilio</td>
                <td>@persona.FechaNacimiento.ToString("dd/MM/yyyy")</td>
            </tr>
        }
    </tbody>
</table>

@code {
